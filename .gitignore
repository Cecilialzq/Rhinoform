# Model/checkpoint payloads are distributed through GitHub Release assets.
# Their JSON sidecars and release manifests remain tracked in Git.
results/**/*.pt
results/**/*.npy
results/**/*.npz

# Per-chunk resume caches are derived artifacts. Their final aggregate evidence
# and hashes are tracked; raw chunks belong in the release bundle if published.
results/**/chunks/
results/**/validation_chunks/

# Large regenerable post-hoc tables are also release assets; compact summaries,
# paired statistics and publication tables remain in Git.
results/**/subunit_pair_metrics_all_methods.csv
results/**/subunit_pair_metrics_unique_majority_sensitivity.csv
results/**/noise_pair_metrics_all_methods.csv
