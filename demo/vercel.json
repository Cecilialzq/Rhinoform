{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify && npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/bundle/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
